generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id             String         @id @default(uuid())
  nome           String
  email          String         @unique
  senhaHash      String
  role           String         @default("ALUNO")
  faixa          String         @default("BRANCA")
  graus          Int            @default(0)
  modoInterface  String         @default("ADULTO")
  diarioTreinos  DiarioTreino[]
  criadoEm       DateTime       @default(now())
}

model DiarioTreino {
  id                 String   @id @default(uuid())
  usuarioId          String
  usuario            Usuario  @relation(fields: [usuarioId], references: [id])
  dataTreino         DateTime @default(now())
  posicoesAprendidas String
  qtdRolas           Int      @default(0)
  nivelDesgaste      Int
  doresRelatadas     String
  anotacoes          String?
}

